{
  "hooks": {
    "PostCompact": [
      {
        "hooks": [
          {
            "command": "bd codex-hook PostCompact",
            "statusMessage": "Scheduling Beads context refresh",
            "type": "command"
          }
        ],
        "matcher": "manual|auto"
      }
    ],
    "PreToolUse": [
      {
        "description": "Block destructive shell commands and unsafe recursive removes",
        "hooks": [
          {
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/block-dangerous-commands.sh\"",
            "statusMessage": "Checking command safety",
            "type": "command"
          }
        ],
        "matcher": "^Bash$"
      },
      {
        "description": "Block direct edits to Beads-generated workstream mirrors",
        "hooks": [
          {
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/block-generated-edits.sh\"",
            "statusMessage": "Checking generated-file policy",
            "type": "command"
          }
        ],
        "matcher": "^apply_patch$"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bd codex-hook PreCompact",
            "statusMessage": "Checking Beads context",
            "type": "command"
          }
        ],
        "matcher": "manual|auto"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd codex-hook SessionStart",
            "statusMessage": "Loading Beads context",
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "bd codex-hook UserPromptSubmit",
            "statusMessage": "Refreshing Beads context",
            "type": "command"
          }
        ]
      }
    ]
  }
}
