<?xml version="1.0" encoding="UTF-8"?>
<!--
  Synthetic BSE-style Q3 FY25 (Oct-Dec 2024) CONSOLIDATED Ind AS instance for the
  SAME fictional issuer as synthetic_wave1_nse_q3fy25_consolidated.xml, hosted
  under the BSE scrip identity (bse-scrip 999999), under the in-bse-fin taxonomy.

  Values are identical to the NSE twin so the two first-party hosts reconcile to
  AGREE once each observation is canonicalised to the same issuer. Invented data,
  not any real company; internally consistent (PBT 200 = Income 1010 - Expenses 810).
-->
<xbrli:xbrl
    xmlns:xbrli="http://www.xbrl.org/2003/instance"
    xmlns:xbrldi="http://xbrl.org/2006/xbrldi"
    xmlns:iso4217="http://www.xbrl.org/2003/iso4217"
    xmlns:in-bse-fin="http://www.bseindia.com/xbrl/fin/2020-03-31/in-bse-fin">

  <xbrli:context id="OneD">
    <xbrli:entity>
      <xbrli:identifier scheme="http://www.bseindia.com/xbrl/scrip">999999</xbrli:identifier>
    </xbrli:entity>
    <xbrli:period>
      <xbrli:startDate>2024-10-01</xbrli:startDate>
      <xbrli:endDate>2024-12-31</xbrli:endDate>
    </xbrli:period>
  </xbrli:context>

  <xbrli:unit id="INR">
    <xbrli:measure>iso4217:INR</xbrli:measure>
  </xbrli:unit>
  <xbrli:unit id="INRPerShare">
    <xbrli:divide>
      <xbrli:unitNumerator>
        <xbrli:measure>iso4217:INR</xbrli:measure>
      </xbrli:unitNumerator>
      <xbrli:unitDenominator>
        <xbrli:measure>xbrli:shares</xbrli:measure>
      </xbrli:unitDenominator>
    </xbrli:divide>
  </xbrli:unit>

  <in-bse-fin:NatureOfReportStandaloneConsolidated contextRef="OneD">Consolidated</in-bse-fin:NatureOfReportStandaloneConsolidated>

  <in-bse-fin:RevenueFromOperations contextRef="OneD" unitRef="INR" decimals="-7">10000000000.00</in-bse-fin:RevenueFromOperations>
  <in-bse-fin:Income contextRef="OneD" unitRef="INR" decimals="-7">10100000000.00</in-bse-fin:Income>
  <in-bse-fin:Expenses contextRef="OneD" unitRef="INR" decimals="-7">8100000000.00</in-bse-fin:Expenses>
  <in-bse-fin:ProfitBeforeTax contextRef="OneD" unitRef="INR" decimals="-7">2000000000.00</in-bse-fin:ProfitBeforeTax>
  <in-bse-fin:ProfitLossForPeriod contextRef="OneD" unitRef="INR" decimals="-7">1500000000.00</in-bse-fin:ProfitLossForPeriod>
  <in-bse-fin:ProfitOrLossAttributableToOwnersOfParent contextRef="OneD" unitRef="INR" decimals="-7">1500000000.00</in-bse-fin:ProfitOrLossAttributableToOwnersOfParent>
  <in-bse-fin:BasicEarningsLossPerShareFromContinuingAndDiscontinuedOperations contextRef="OneD" unitRef="INRPerShare" decimals="2">5.00</in-bse-fin:BasicEarningsLossPerShareFromContinuingAndDiscontinuedOperations>

</xbrli:xbrl>
