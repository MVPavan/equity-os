# Copy to .env (untracked) and fill in. Never commit .env.
# Create it with an empty `.eqos-host-mount` file at its root; postgres refuses to start without it.
EQOS_PG_DATA_DIR=/absolute/host/path/for/postgres/data
EQOS_PG_DB=equity_os
# The bootstrap superuser's name, read only by compose. Its password and the migrator's are not
# kept here: privileged commands (db bootstrap/migrate/backup/restore/create-test, retention
# purge/licence-end) read `eqos_admin.login` and `eqos_migrator.login`, one 0600 line
# `<login>:<password>` each, from ${EQOS_SECRETS_DIR:-~/.secrets}. Runtime commands never do.
EQOS_PG_USER=equity_os
# Equity-OS-specific host port; deliberately not 5432 (other Postgres instances share this machine).
EQOS_PG_PORT=55432
# Host the services bind to (compose publishes on loopback only).
EQOS_PG_HOST=127.0.0.1
# Login password for the fixed eqos_runtime role; `fundamentals db bootstrap` creates a missing
# role with it (and eqos_migrator with the password in eqos_migrator.login) and never alters an
# existing one.
EQOS_PG_RUNTIME_PASSWORD=change-me
# Tests create and drop only databases with this prefix; it must not match EQOS_PG_DB.
EQOS_PG_TEST_DB_PREFIX=eqos_test_
